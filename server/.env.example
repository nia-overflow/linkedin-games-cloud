# Server environment variables
# Copy to server/.env for local cloud-mode testing

# ── Supabase (required for cloud mode) ────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role key (never expose to browser)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Railway sets these automatically ─────────────────────────────────────────
# DATABASE_URL=postgresql://...      # Supabase pooler URL (not used directly)
