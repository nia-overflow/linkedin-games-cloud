# Dashboard build-time environment variables
# Copy to dashboard/.env.local for development (Vite picks it up automatically)

# ── Supabase (required for auth) ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...       # anon/public key (safe to expose in browser)

# ── When both vars are absent, the dashboard runs in local mode ───────────────
# (no login screen, no auth — original single-user behavior)
