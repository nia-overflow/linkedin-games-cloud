<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: runs the LinkedIn Games scraper at 8:00 AM daily.

  Useful if you play games in the morning rather than late at night.
  Install alongside the nightly agent (or instead of it) via:

    bash scripts/install-daemons.sh --morning

  Logs:
    ~/.linkedin-games/logs/scraper-morning.log
    ~/.linkedin-games/logs/scraper-morning-error.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.linkedingames.scraper-morning</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>--dir</string>
    <string>LINKEDIN_GAMES_PROJECT_DIR</string>
    <string>scrape</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>HOME_DIR</string>
  </dict>

  <!-- Run at 08:00 daily -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>HOME_DIR/.linkedin-games/logs/scraper-morning.log</string>

  <key>StandardErrorPath</key>
  <string>HOME_DIR/.linkedin-games/logs/scraper-morning-error.log</string>

  <!-- Do NOT start at login — only at the scheduled time -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
