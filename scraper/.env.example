# Scraper environment variables
# Place at ~/.linkedin-games/.env  (NOT in the repo)

# ── Cloud push (optional — scraper works fine without these) ──────────────────
CLOUD_ENDPOINT=https://your-app.up.railway.app
CLOUD_API_KEY=lgk_...               # Generate in the dashboard Settings page

# ── Local overrides (rarely needed) ──────────────────────────────────────────
# CHROME_PROFILE_PATH=/custom/path/to/chrome-profile
